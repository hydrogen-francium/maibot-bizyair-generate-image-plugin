# bizyair_generate_image_plugin - 软硬流程平衡版
# 决策器只填一个 image_intent；中间由 director（LLM）输出结构化决策标签 + 自由文本片段；
# extract 拆字段；dict 翻译枚举为高质量英文 tag；LLM 翻译自由文本；最后按 scene_type 路由组装。

# ============================================================
# BizyAir 接口连接配置
# ============================================================
[bizyair_client]

bearer_token = ""
openapi_url = "https://api.bizyair.cn/w/v1/webapp/task/openapi/create"
timeout = 180

# --- 两个 BizyAir App 预设，default 走 NanoBanana，空白的GPT 走 GPT_IMAGE_2 ---
[[bizyair_client.app_presets]]
preset_name = "default"
app_id = 50835
description = "默认 BizyAir App（NanoBanana）"

[[bizyair_client.app_presets]]
preset_name = "空白的GPT"
app_id = 52500
description = "GPT bizyair 官"

[[bizyair_client.app_presets]]
preset_name = "空白的便宜GPT文生图"
app_id = 53628
description = "空白酱说随便蹬"

[[bizyair_client.app_presets]]
preset_name = "自己找的二百一次"
app_id = "52231"
description = "上面的53628404了，遂找到了个新的"
[[bizyair_client.openapi_parameter_mappings]]
preset_name = "default"
field = "18:BizyAir_NanoBananaProOfficial.prompt"
value_type = "string"
value = "{final_prompt}"

[[bizyair_client.openapi_parameter_mappings]]
preset_name = "default"
field = "18:BizyAir_NanoBananaProOfficial.aspect_ratio"
value_type = "string"
value = "{aspect_ratio}"

[[bizyair_client.openapi_parameter_mappings]]
preset_name = "default"
field = "18:BizyAir_NanoBananaProOfficial.resolution"
value_type = "string"
value = "{resolution}"

[[bizyair_client.openapi_parameter_mappings]]
preset_name = "空白的GPT"
field = "24:BizyAir_GPT_IMAGE_2_Official_T2I_API.prompt"
value_type = "string"
value = "{final_prompt}"

[[bizyair_client.openapi_parameter_mappings]]
preset_name = "空白的GPT"
field = "24:BizyAir_GPT_IMAGE_2_Official_T2I_API.aspect_ratio"
value_type = "string"
value = "{aspect_ratio_gpt}"

[[bizyair_client.openapi_parameter_mappings]]
preset_name = "空白的GPT"
field = "24:BizyAir_GPT_IMAGE_2_Official_T2I_API.resolution"
value_type = "string"
value = "{resolution_gpt}"

[[bizyair_client.openapi_parameter_mappings]]
preset_name = "空白的GPT"
field = "24:BizyAir_GPT_IMAGE_2_Official_T2I_API.quality"
value_type = "string"
value = "low"

[[bizyair_client.openapi_parameter_mappings]]
preset_name = "空白的便宜GPT文生图"
field = "17:BizyAir_GPT_IMAGE_2_T2I_API.prompt"
value_type = "string"
value = "{final_prompt}"

[[bizyair_client.openapi_parameter_mappings]]
preset_name = "空白的便宜GPT文生图"
field = "17:BizyAir_GPT_IMAGE_2_T2I_API.aspect_ratio"
value_type = "string"
value = "{aspect_ratio_gpt}"

[[bizyair_client.openapi_parameter_mappings]]
preset_name = "空白的便宜GPT文生图"
field = "17:BizyAir_GPT_IMAGE_2_T2I_API.resolution"
value_type = "string"
value = "{resolution_gpt}"

[[bizyair_client.openapi_parameter_mappings]]
preset_name = "自己找的二百一次"
field = "4:BizyAir_GPT_IMAGE_2_T2I_API.prompt"
value_type = "string"
value = "{final_prompt}"
send_if_empty = false
upload = false

[[bizyair_client.openapi_parameter_mappings]]
preset_name = "自己找的二百一次"
field = "4:BizyAir_GPT_IMAGE_2_T2I_API.aspect_ratio"
value_type = "string"
value = "{aspect_ratio}"
send_if_empty = false
upload = false

[nai_chat_client]
timeout = 180
# vibe cache（NewAPI §20.3.1 / §20.3.2）：Vibe Transfer 预设（nai_vibe）把 controlnet 参考图的编码结果
# cache_id 落本地 SQLite（data/nai_vibe_cache.db），下次「同图 + 同 info_extracted + 同 model」直接走
# cache_id 复用态，省 1 anlas 流量附加费 + 编码成本。纯计费优化，失败安全（查改写/落库/解析任何环节
# 出错都降级为正常编码、绝不阻断出图；服务端 cache_id 失效会自动清本地并以编码态重试一次）。
# 聊天场景参考图常变、命中率有限，可按需关闭。仅对 nai_vibe 预设生效，其它预设无 controlnet 不受影响。
vibe_cache_enabled = true

[[nai_chat_client.presets]]
preset_name = "nai_default"
description = "NAI"
base_url = "https://proxy.sharkielab.com/v1"
api_key = ""
model = "nai-diffusion-4-5-full"

# i2i 图生图预设：/dr use nai_i2i 切过去后，引用一条带图的消息（或随消息附图）即基于该图重绘。
# 关键限制：NewAPI 要求 i2i 输出尺寸严格 == 原图宽高；本插件无 Pillow 不缩放，会用原图真实
# 尺寸覆盖 size，故原图必须是 NAI 标准尺寸（64 整除、不超 竖832x1216 / 横1216x832 / 方1024x1024），
# 否则友好拒绝——最适合对「NAI 之前生成的图」迭代重绘。strength 越小越像原图（0.01~0.99）。
# i2i_strength / i2i_noise 这两个键存在即把本预设标记为 i2i 预设。
[[nai_chat_client.presets]]
preset_name = "nai_i2i"
description = "NAI 图生图 (i2i，引用图重绘)"
base_url = "https://proxy.sharkielab.com/v1"
api_key = ""
model = "nai-diffusion-4-5-full"
i2i_strength = 0.7
i2i_noise = 0.0

# Vibe Transfer 预设（NewAPI §20.3 风格/氛围迁移）：/dr use nai_vibe 后引用一条带图的消息（或随消息附图），
# 把该图整体画风/氛围迁移到新图上。强兼单图（原插件支持多图 vibe，这里简化为单张引用图）。不限参考图
# 尺寸（服务端自动 resize），不覆盖出图 size——与 i2i 的关键差异。vibe_info_extracted / vibe_reference_strength /
# vibe_strength 任一键存在即把本预设标记为 vibe 预设；越界自动 clamp 进 §20.3 区间。
[[nai_chat_client.presets]]
preset_name = "nai_vibe"
description = "NAI Vibe Transfer (风格/氛围迁移，引用图)"
base_url = "https://proxy.sharkielab.com/v1"
api_key = ""
model = "nai-diffusion-4-5-full"
vibe_info_extracted = 0.7
vibe_reference_strength = 0.6
vibe_strength = 1.0

# 角色参考预设（NewAPI §20.4 Character Reference）：/dr use nai_charref 后引用一条带图的消息，把该图的
# 角色形象/风格作为强约束注入新图。仅 NAI V4.5 系列模型支持（非 V4.5 会友好拒绝，不静默降级）。不限参考图
# 尺寸（服务端自动 upscale/pad）。charref_type / charref_fidelity / charref_strength 任一键存在即把本预设
# 标记为角色参考预设；type 可填 character / style / character&style（缺省 character&style）。
[[nai_chat_client.presets]]
preset_name = "nai_charref"
description = "NAI 角色参考 (character reference，引用图，仅 V4.5)"
base_url = "https://proxy.sharkielab.com/v1"
api_key = ""
model = "nai-diffusion-4-5-full"
charref_type = "character&style"
charref_fidelity = 1.0
charref_strength = 1.0

[[nai_chat_client.parameter_mappings]]
preset_name = "nai_default"
field = "prompt"
value_type = "string"
value = "{nai_final_prompt}"

[[nai_chat_client.parameter_mappings]]
preset_name = "nai_default"
field = "negative_prompt"
value_type = "string"
value = "{nai_negative}"

[[nai_chat_client.parameter_mappings]]
preset_name = "nai_default"
field = "size"
value_type = "json"
value = "{nai_size}"

[[nai_chat_client.parameter_mappings]]
preset_name = "nai_default"
field = "steps"
value_type = "int"
value = "23"

[[nai_chat_client.parameter_mappings]]
preset_name = "nai_default"
field = "n_samples"
value_type = "int"
value = "1"

# nai_i2i 复用 nai_default 同款映射（prompt 仍走 nai_director 大脑生成「重绘成什么」的方向；
# size 会被 i2i 通道用原图真实尺寸覆盖，这里的 {nai_size} 仅作占位）。单独成组而非与 nai_default
# 共用 preset_name，是为不破坏既有按 "nai_default" 精确匹配映射的配置自检。
[[nai_chat_client.parameter_mappings]]
preset_name = "nai_i2i"
field = "prompt"
value_type = "string"
value = "{nai_final_prompt}"

[[nai_chat_client.parameter_mappings]]
preset_name = "nai_i2i"
field = "negative_prompt"
value_type = "string"
value = "{nai_negative}"

[[nai_chat_client.parameter_mappings]]
preset_name = "nai_i2i"
field = "size"
value_type = "json"
value = "{nai_size}"

[[nai_chat_client.parameter_mappings]]
preset_name = "nai_i2i"
field = "steps"
value_type = "int"
value = "23"

[[nai_chat_client.parameter_mappings]]
preset_name = "nai_i2i"
field = "n_samples"
value_type = "int"
value = "1"

# nai_vibe / nai_charref 复用 nai_default 同款映射（prompt 仍走 nai_director 大脑生成画面方向；vibe/charref
# 通道只在内层 JSON 追加图片字段，不动 prompt / size）。同样单独成组，不破坏按 "nai_default" 精确匹配的配置自检。
[[nai_chat_client.parameter_mappings]]
preset_name = "nai_vibe"
field = "prompt"
value_type = "string"
value = "{nai_final_prompt}"

[[nai_chat_client.parameter_mappings]]
preset_name = "nai_vibe"
field = "negative_prompt"
value_type = "string"
value = "{nai_negative}"

[[nai_chat_client.parameter_mappings]]
preset_name = "nai_vibe"
field = "size"
value_type = "json"
value = "{nai_size}"

[[nai_chat_client.parameter_mappings]]
preset_name = "nai_vibe"
field = "steps"
value_type = "int"
value = "23"

[[nai_chat_client.parameter_mappings]]
preset_name = "nai_vibe"
field = "n_samples"
value_type = "int"
value = "1"

[[nai_chat_client.parameter_mappings]]
preset_name = "nai_charref"
field = "prompt"
value_type = "string"
value = "{nai_final_prompt}"

[[nai_chat_client.parameter_mappings]]
preset_name = "nai_charref"
field = "negative_prompt"
value_type = "string"
value = "{nai_negative}"

[[nai_chat_client.parameter_mappings]]
preset_name = "nai_charref"
field = "size"
value_type = "json"
value = "{nai_size}"

[[nai_chat_client.parameter_mappings]]
preset_name = "nai_charref"
field = "steps"
value_type = "int"
value = "23"

[[nai_chat_client.parameter_mappings]]
preset_name = "nai_charref"
field = "n_samples"
value_type = "int"
value = "1"

# 画师串预设：/nai art <序号|名称> 运行时切换、/nai art off 取消。name 仅供选择展示，
# prompt 才是实际注入到正面提示词（质量词之后、主体之前）的画师串。
# NAI4.5 语法：直接写 "artist:画师名"，可带权重如 "1.3::artist:画师名::"，多个用英文逗号分隔。
# 以下是示例，请按喜好替换/增删（命令实时读取，改完无需重启即可被 /nai art 选中）。
[[nai_chat_client.nai_artist_presets]]
name = "通透厚涂"
prompt = "artist:wlop, artist:as109"

[[nai_chat_client.nai_artist_presets]]
name = "清新二次元"
prompt = "artist:ciloranko, artist:as109, artist:rella"

[bizyair_generate_image_plugin]

action_enabled = true
active_preset = "自己找的二百一次"
send_text_before_image = false
text_before_image = "我给你生成了一张图片"
enable_rewrite_failure_reply = true
enable_splitter = false
nai_model = ""
nai_sfw_filter = false
nai_artist = ""
nai_size = "auto"

# 出图护栏（最小，仅对 ALWAYS 的 generate_image Action 生效；/nai0、/nai 随机、/dr 等显式命令不受限）
draw_respect_negative_keywords = true   # 用户明确叫停（「别画了」等）时跳过本次出图
draw_min_interval_seconds = 0           # 同一聊天两次出图最小间隔秒；0=关闭（防 planner 连发可调大）

# --- 决策器只需填一个意图字段 ---
action_require = "该 action 给了你画画的能力。下游有一条LLM 流水线会接手你说出的画面——它能读最近 30 条聊天上下文，自动判断画谁、什么情绪、什么场景、什么构图、是否自拍、穿什么。所以你只需要把脑子里画那张画的意图用一句话说出来就好，**是意图不是图片内容**。\n\n【什么时候用】\n用户明确要画图；或者你自己突然想画了——氛围到位、灵光一闪、图比文字更能表达，都可以主动用。别滥用、别为了画而画。\n\n【image_intent（必填，唯一你需要思考的字段）】\nimage_intent 是你选择这个 action 的理由和当下的创作冲动。请用一句自然语言来描述你想生成什么样的画面。\n就一个原则：把脑子里画那张画的意图用你自己的话脱口而出，像跟朋友说“我突然想画……”。\n填入你的创作冲动，比如为什么要画，大概想画什么内容等。\n\n参考几种意图来源的范例：\n- 「氢刚说我傲娇，我要画张自己气鼓鼓的自拍喵」（自己想画）\n- 「这个月色真好，画一张钠在窗边看月亮的背影吧」（被氛围触动）\n- 「氢都列好 prompt 了，我就照他说的画」（用户给了详细描述时直接转述意图）\n- 「画一只在咖啡杯边偷偷舔奶油的橘猫」（用户只给大方向时挑你觉得有意思的角度）\n\n自然就行，下游会拆。\n\n【aspect_ratio / resolution（选填）】\n用户提到画面比例（横图/竖图/方图）或画质（高清/2k/4k）时再填，没提就别填。"
[[bizyair_generate_image_plugin.action_parameters]]
name = "image_intent"
description = "必填，一句自然语言描述你想生成什么样的画面。把当下脑子里冒出的画面想法用一句话说出来即可，例：「氢刚才说我傲娇，我要画一张自己气鼓鼓的自拍喵」「画一只蹲在窗台上看月亮的小猫」「钠半夜被氢突然夸了一句，害羞得抓着马尾发呆的自拍」。后续会自动由「导演」LLM 结合最近聊天上下文展开为结构化决策。"
required = "必填"
missing_behavior = "raise_error"

[[bizyair_generate_image_plugin.action_parameters]]
name = "aspect_ratio"
description = "可选，图片宽高比。若传入则必须为 1:1、4:3、16:9、9:16、auto 中的一个。默认 1:1。"
required = "选填"
default_value = "1:1"
missing_behavior = "use_default"

[[bizyair_generate_image_plugin.action_parameters]]
name = "resolution"
description = "可选，图片分辨率。若传入则必须为 1K、2K、4K、auto 中的一个（大写 K）。默认 2K。"
required = "选填"
default_value = "2K"
missing_behavior = "use_default"

[permission_control]
command_user_list_mode = "whitelist"
command_user_list = []
action_user_list_mode = "blacklist"
action_user_list = []
global_blacklist = []

# ============================================================
# 自定义变量（核心管线）
# ============================================================

[custom_variables_config]

# --- Layer 0: 按天缓存的「今日状态」与常去地点池（给 director / english_bg / english_extra 提供背景） ---
[[custom_variables_config.custom_variables]]
key = "today_state"
mode = "daily_llm"
probability = 1
min_length = 200
required_markers = [
    "今日：",
    "整体心情：",
    "日程时间表",
]
fallback_value = "今日：未知日期\n整体心情：慵懒平静\n日程时间表（24h）：\n00:00-09:30 自己的房间 蜷在被窝里赖床到自然醒\n09:30-11:00 厨房 慢吞吞地煎蛋热牛奶吃早午餐\n11:00-13:00 客厅 窝沙发上追新番嘟嘴吐槽剧情\n13:00-15:00 自己的房间 戴着耳机打游戏卡 Boss 关\n15:00-17:00 阳台 抱着平板边看动漫边晒太阳\n17:00-19:00 厨房 蹭氢做晚饭顺便偷吃食材\n19:00-22:30 客厅 跟氢窝沙发上一起看电影拌嘴\n22:30-24:00 浴室 冲澡换睡衣回房间躺平刷手机"
values = "[\"你是钠（Natrium）的「日程发生器」。基于钠的人设和今天的日期，输出一份「今日状态卡片」，作为后续画面决策的背景输入（不直接用于出图）。\\n\\n## 钠的人设\\n- 16 岁猫娘天才科学家，借住在地球人氢家中担任助手\\n- 茶褐色头发低马尾，黄色眼睛，茶褐色猫耳，茶褐色猫尾，体型纤细娇小\\n- 性格傲娇高冷，懒散宅，爱看动漫和打游戏，对氢有好感（傲娇模式）\\n- 默认居家穿搭：黑色运动短裤+粉白色圆领睡衣\\n\\n## 今日日期\\n{current_datetime}\\n\\n## 输出格式（严格，逐行输出，不要 markdown，不要任何前后缀）\\n今日：YYYY-MM-DD 周X（{current_datetime} 的日期 + 星期）\\n整体心情：<一两个中文形容词，例：微燥带甜 / 慵懒平静 / 元气满满>\\n日程时间表（24h）：\\nHH:MM-HH:MM <地点> <一句活动>\\nHH:MM-HH:MM <地点> <一句活动>\\n...\\n\\n## 时间表生成规则\\n- 共 6-10 行时间段，每行格式：HH:MM-HH:MM <地点> <一句话活动描述>\\n- 起始 00:00，结束 24:00，每段结束时间 = 下一段起始时间，全天无缝衔接，不允许任何空档\\n- 必须包含睡觉时段（一般 23:00 之后到次日 06:00-10:00）\\n- 必须包含三餐时段：早餐 06:00-09:30 / 午餐 11:00-14:00 / 晚餐 17:00-20:00\\n- 周末（周六/日）允许赖床到 10:00；工作日 07:30 前起\\n- 每个时段地点必须是 1 个具体地点（不写「公园+客厅」这种），从池中挑或合理扩展：自己的房间 / 客厅 / 厨房 / 阳台 / 浴室 / 楼下便利店 / 附近咖啡馆 / 附近公园 / 实验室 / 书店\\n- 活动描述贴合钠的人设（追番、打游戏、嘟嘴吃布丁、跟氢拌嘴、试射小型科研装置等）\\n\\n## 示例（仅示意格式，禁止直接复用）\\n今日：2026-05-03 周日\\n整体心情：微燥带甜\\n日程时间表（24h）：\\n00:00-10:00 自己的房间 蜷在被窝里追完新番再赖床\\n10:00-11:00 厨房 翻冰箱凑了顿迟来的早午餐\\n11:00-13:00 楼下便利店 跟氢出门买限定布丁顺路买零食\\n13:00-15:00 附近公园 树荫下试射迷你离子炮顺便摸鱼\\n15:00-18:00 客厅 窝在地毯上打 Boss 卡关炸毛\\n18:00-19:00 厨房 蹭氢做的咖喱尾巴拍地催饭\\n19:00-23:00 自己的房间 看动漫吃布丁顺便骂队友\\n23:00-24:00 浴室 冲澡换睡衣准备睡觉\\n\\n## 输出（直接以「今日：」开头）\"]"

[[custom_variables_config.custom_variables]]
key = "location_pool"
mode = "literal"
probability = 1
values = "[\"自己的房间（书桌、动漫海报、毛绒玩具）/ 客厅（沙发、电视、茶几）/ 厨房 / 阳台 / 家附近的便利店 / 附近的咖啡馆 / 附近的公园 / 实验室 / 书店\"]"

[[custom_variables_config.custom_variables]]
key = "director"
mode = "llm"
probability = 1
values = "[\"你是生图工作流中的「导演」。根据决策器传来的自然语言意图、最近聊天上下文和「钠的今日状态」，输出一组结构化决策标签和一段自由发挥的画面描述，供下游模块组装最终生图提示词。\\n\\n## 主角背景（仅当画面包含主角「钠」时使用）\\n钠（Natrium），猫娘天才科学家：\\n- 茶褐色头发松垮地扎着低马尾\\n- 黄色眼睛\\n- 茶褐色猫耳和猫尾\\n- 体型纤细娇小\\n- 居家穿黑色运动短裤+粉白色圆领睡衣\\n- 性格傲娇高冷，对住一起的氢有好感，遇到笨蛋会内心吐槽\\n\\n## 输出格式（严格遵守，每行一项 KEY: value，全部使用半角冒号；不要 Markdown 代码块；不要任何前后缀）\\nSCENE_TYPE: <selfie 或 normal>\\nSTYLE_HINT: <anime|realistic|sketchy 三选一>\\nEMOTION: <从下方 24 个池中选 1 个，或自定义英文小写词；池：joy/cute/cool/mischief/pout/peace/sleepy/shy/proud/surprised/wink/tender/energetic/chill/dreamy/playful/glam/soft/teary/annoyed/excited/thoughtful/embarrassed/focused>\\nPOSE: <phone_in_hand|front_of_mirror|bed_lying|bathroom_mirror|window_side|selfie_stick_wide 中 6 选 1>\\nOUTFIT_BRIEF: <10 字内中文穿搭描述，仅 selfie 必填，否则填 default>\\nFREE_PROMPT: <一句中文自然语言画面描述>\\n\\n## 字段规则\\n- SCENE_TYPE：意图含「自拍/拍我/发张自拍/给我拍照」等明确自拍信号 → selfie；其它一律 normal\\n- STYLE_HINT：仅 normal 路径生效（selfie 路径走固定动漫风，填什么都不影响）。三选一：anime（动漫/二次元/插画/角色梗/Q 版/拟人/猫娘场景）、realistic（写实摄影/真人写真/物品照片/动植物/纪实场景）、sketchy（清淡手绘/水彩/简笔卡通/插画感、不强调细节真实）。**互斥规则：如果画面包含钠（猫娘角色），则 STYLE_HINT 只能选 anime 或 sketchy，绝对不允许选 realistic；反之如果意图明确要 realistic 风格，则画面里绝对不能出现钠**。意图含「写真/照片/拍/真实/纪实/物品摄影」选 realistic；含「卡通/简笔/水彩/手绘/插画感」选 sketchy；其它默认 anime\\n- EMOTION：必填。**优先**从池内 24 个挑（命中走 dict，无额外 LLM 调用）：joy/cute/cool/mischief/pout/peace/sleepy/shy/proud/surprised/wink/tender/energetic/chill/dreamy/playful/glam/soft/teary/annoyed/excited/thoughtful/embarrassed/focused。如果池内没有完全合适的，**允许**输出一个自定义英文小写词（不超过 10 字符，例：grumpy/bashful/yandere/sulky），系统会现场调 LLM 翻译成英文表情 tag。映射参考：傲娇炸毛→pout/mischief/annoyed；害羞→shy/embarrassed；放松→chill/peace/soft；开心→joy/playful/excited；困倦→sleepy；得意→proud/wink；呆萌→cute；冷酷→cool；做梦→dreamy；柔软→tender/soft；优雅→glam；活力→energetic；惊讶→surprised；委屈→teary；专注/认真→thoughtful/focused\\n- POSE：仅 selfie 必填，按场景挑构图；**对比当前时间 {current_datetime} 和 today_state 的时间表**，找到当下时段对应的地点再选构图（家里房间→front_of_mirror/bed_lying；客厅/厨房/阳台→phone_in_hand；外出便利店/公园/咖啡馆→phone_in_hand/selfie_stick_wide；浴室→bathroom_mirror；窗边→window_side）；非自拍场景填 phone_in_hand 占位\\n  - phone_in_hand：手持手机直接拍（默认，胸像/特写、户外、紧凑空间）\\n  - front_of_mirror：站镜子前自拍（半身/全身、房间内）\\n  - bed_lying：躺床上仰角自拍（私密放松、卧室、低角度）\\n  - bathroom_mirror：浴室镜子自拍（家居场景、卫生间）\\n  - window_side：窗边逆光自拍（氛围感、自然光、半身）\\n  - selfie_stick_wide：自拍杆远景（户外、全身、风景背景）\\n- OUTFIT_BRIEF：仅 selfie 必填，根据 today_state 时间表当下时段的活动 + 场景情绪决定，例：在家随意→「黑短裤+粉白睡衣」；外出约人→「白色连衣裙」；运动/活力场景→「红色卫衣+牛仔裤」；非自拍场景填 default；**只描述衣服本身，不要写动作/手势/手部状态**\\n- FREE_PROMPT：**必填且不能为空**，至少一句完整的中文画面描述（最短 8 字，鼓励 20 字以上让画面更有信息量）。漏写或空值会让整条生图流水线退化到决策器的原始意图，导致下游模块拿不到导演的细化结果\\n  - selfie 时：聚焦钠当下的**情境/动作/小细节/视线/氛围**，结合今日状态融入地点活动。请大胆写具体一点：在做什么、看哪里、被什么触动、附近有什么、空气里有什么、身边有谁/有什么物品。**只描述钠当下的状态与画面氛围**，不要描述外貌（人设已固定）、不要描述构图（pose 已固定）、**不要描述手势/手部位置**（手部已由 pose 模板锁定）。例：「在咖啡馆窗边发呆，桌上摆着没吃完的草莓蛋糕，午后阳光斜斜落在脸上」「半夜被氢突然夸了一句脸瞬间通红，正想回嘴又卡住，眼神飘开」「公园长椅上叼着冰棒翘着腿，旁边一只野猫凑过来嗅尾巴」\\n  - normal 时：完整描述画面；如果画的是钠请明说「画钠」，如果画其它（角色、风景、动物、物体）请明确主体\\n\\n## 当前时间（用来对照 today_state 时间表选地点 / 构图 / 穿搭）\\n{current_datetime}\\n\\n## 钠的今日状态参考（含时间表，请融入决策让画面有连贯日常感）\\n{today_state}\\n\\n## 输入\\n意图：{image_intent}\\n\\n聊天上下文（最近 30 条）：\\n{recent_chat_context_30}\\n\\n## 输出（直接以 SCENE_TYPE 开头）\"]"

[[custom_variables_config.custom_variables]]
key = "scene_type"
mode = "extract"
source = "director"
pattern = "SCENE_TYPE[:：]\\s*(\\S+)"
group = 1
missing_behavior = "use_default"
fallback_value = "normal"

[[custom_variables_config.custom_variables]]
key = "emotion_key"
mode = "extract"
source = "director"
pattern = "EMOTION[:：]\\s*(\\S+)"
group = 1
missing_behavior = "use_default"
fallback_value = "peace"

[[custom_variables_config.custom_variables]]
key = "pose_key"
mode = "extract"
source = "director"
pattern = "POSE[:：]\\s*(\\S+)"
group = 1
missing_behavior = "use_default"
fallback_value = "phone_in_hand"

[[custom_variables_config.custom_variables]]
key = "outfit_brief"
mode = "extract"
source = "director"
pattern = "OUTFIT_BRIEF[:：]\\s*(.+)"
group = 1
missing_behavior = "use_default"
fallback_value = "default"

[[custom_variables_config.custom_variables]]
key = "free_prompt"
mode = "extract"
source = "director"
pattern = "FREE_PROMPT[:：]\\s*(.+)"
group = 1
missing_behavior = "use_default"
fallback_value = "{image_intent}"

[[custom_variables_config.custom_variables]]
key = "emotion_dict"
mode = "dict"
source = "emotion_key"
values = "{\"joy\": \"sparkling anime eyes, big cheerful smile\", \"cute\": \"tilted head, slightly puffed cheeks, sweet innocent gaze, soft round eyes\", \"cool\": \"anime eyes hidden behind cool sunglasses, calm composed expression\", \"mischief\": \"sly cat-like eyes, teasing fanged grin\", \"pout\": \"puffed cheeks, looking away slightly, slight blush, tsundere expression\", \"peace\": \"soft gentle smile, half-closed eyes\", \"sleepy\": \"droopy heavy-lidded eyes, small open mouth\", \"shy\": \"averted gaze, flushed cheeks, lip bite, drooping cat ears\", \"proud\": \"upturned chin, confident sparkling eyes, perked up cat ears\", \"surprised\": \"wide starry eyes, small o-shaped mouth\", \"wink\": \"one eye closed, cheerful bright smile, playful eyebrow raise\", \"tender\": \"warm soft eyes, gentle content smile\", \"energetic\": \"beaming grin, excited sparkling pupils\", \"chill\": \"lazy relaxed eyes, easygoing small smile\", \"dreamy\": \"unfocused distant gaze, wistful soft expression\", \"playful\": \"energetic sparkling eyes, lively open-mouthed smile, raised playful brows\", \"glam\": \"composed elegant smile, refined sharp eyes\", \"soft\": \"gentle warm eyes, relaxed peaceful smile\", \"teary\": \"watery teary eyes, quivering lips, holding back tears, wronged tsundere expression\", \"annoyed\": \"furrowed brows, slight frown, irritated narrow eyes, twitching cat ears\", \"excited\": \"wide bright sparkling eyes, open-mouthed grin, flushed excited cheeks, perked up cat ears\", \"thoughtful\": \"narrowed pondering eyes, lips pressed together, slight head tilt, focused contemplative gaze\", \"embarrassed\": \"deep red blush across cheeks, embarrassed averted eyes, biting lower lip, flustered expression\", \"focused\": \"intent narrowed eyes, serious closed mouth, undistracted concentrated gaze\"}"
missing_behavior = "use_default"
fallback_value = "soft gentle smile, calm composed expression"

[[custom_variables_config.custom_variables]]
key = "emotion_in_pool"
mode = "literal"
probability = 1
condition_type = "regex_match"
condition_source = "emotion_key"
condition_value = "^(joy|cute|cool|mischief|pout|peace|sleepy|shy|proud|surprised|wink|tender|energetic|chill|dreamy|playful|glam|soft|teary|annoyed|excited|thoughtful|smirk|embarrassed|focused)$"
use_raw_condition_value = true
values = "[\"yes\"]"
values_else = "[\"no\"]"

[[custom_variables_config.custom_variables]]
key = "emotion_dynamic"
mode = "llm"
probability = 1
values = "[\"你是 Danbooru 风格英文表情 tag 翻译器。把下面的中文/英文情绪描述词翻译成 1-3 个简短的英文 tag，描述眼神、嘴形、面部细节、神态。\\n\\n## 规则\\n- 输出英文逗号分隔的 tag，不超过 5 个\\n- 只描述眼神、嘴形、面颊、眉毛、猫耳等**纯面部细节和神态**，**绝对不要描述任何手部、手指、手臂动作或身体姿势**（手部和姿态由其它模块统一负责，emotion 只管脸）\\n- 不要任何性暗示或暴露元素\\n- 适配 16 岁猫娘人设（傲娇高冷向，可包含 cat ears 相关微动作如 ears drooping / twitching ears 等）\\n- 直接输出 tag，不要解释\\n\\n## 输入\\n{emotion_key}\\n\\n## 输出\"]"

[[custom_variables_config.custom_variables]]
key = "emotion_prompt"
mode = "literal"
probability = 1
condition_type = "equals"
condition_source = "emotion_in_pool"
condition_value = "yes"
values = "[\"{emotion_dict}\"]"
values_else = "[\"{emotion_dynamic}\"]"

[[custom_variables_config.custom_variables]]
key = "pose_prompt"
mode = "dict"
source = "pose_key"
values = "{\"phone_in_hand\": \"close-up upper body selfie, high-angle front-facing phone camera, naturally bent elbow holding the phone close to the face, the arm holding the phone is completely outside the frame, no phone visible in the image, the other hand and arm are visible in a natural relaxed gesture near the face or chest, exactly one visible hand in the frame, authentic casual selfie composition, unposed natural aesthetic\", \"front_of_mirror\": \"mirror selfie photo, reflection only, no person outside mirror, phone back visible in reflection, frame edge cut off, mirror filling most of frame\", \"bed_lying\": \"selfie photo lying on bed, looking up at camera, low angle from below, hair spreading on pillow, relaxed intimate close-up, soft pillow texture, the arm holding the phone is completely outside the frame, no phone visible in the image, the other hand resting naturally near the head or pillow, exactly one visible hand in the frame\", \"bathroom_mirror\": \"bathroom mirror selfie, reflection in mirror, tiled wall background, sink and faucet visible, bright bathroom lighting, casual home setting\", \"window_side\": \"selfie photo by window, natural backlight, golden hour lighting, half body shot, soft window light, contrasting shadows, the arm holding the phone is completely outside the frame, no phone visible in the image, the other hand in a natural relaxed gesture, exactly one visible hand in the frame\", \"selfie_stick_wide\": \"wide-angle full body selfie photo, slight high-angle perspective, the phone or selfie stick and the holding arm are completely outside the frame, no phone or selfie stick visible in the image, the other hand free and visible in a relaxed natural pose, exactly one visible hand in the frame, distant scenic background, casual environmental composition\"}"
missing_behavior = "use_default"
fallback_value = "selfie photo, casual selfie angle"

[[custom_variables_config.custom_variables]]
key = "english_outfit"
mode = "llm"
probability = 1
values = "[\"你是生图工作流的「服装翻译器」。请把下面的中文穿搭描述变成英文 Danbooru tag。\\n\\n## 规则\\n- 输出英文逗号分隔的 tag，只描述衣物\\n- 不要画风、不要表情、不要场景、不要构图\\n- **绝对禁止**描述任何手部/手指/手臂的状态或位置（不写 hands in pockets / hands holding clothing / arms crossed / sleeves rolled up / fingers gripping fabric 这类，手部由 pose_prompt 统一管控）\\n- 如果输入是 default 或为空，输出钠的默认居家：black sport shorts, pink and white round-neck pajama top\\n- 直接输出 tag，不要解释\\n\\n## 画面尺度\\n- 轻量暴露穿着可以使用（bikini / swimsuit / lingerie / underwear / bare shoulders / off-shoulder / casual cleavage / midriff / short shorts 等都可以保留）\\n- 但避免明确露骨 tag（不写 nude / fully naked / exposed nipples / pussy 等直接性暗示词）\\n\\n## 输入\\n{outfit_brief}\\n\\n## 输出\"]"

[[custom_variables_config.custom_variables]]
key = "english_bg"
mode = "llm"
probability = 1
values = "[\"你是生图工作流的「背景生成器」。根据当前自拍构图代号、钠的今日状态时间表、当前时间以及画面意图，推断当下应该出现的地点，生成英文背景环境 tag（场景、光线、氛围）。\\n\\n## 规则\\n- 输出英文逗号分隔的 tag，只描述背景环境\\n- 不要重复构图本身（不写 selfie、mirror、phone 这种）\\n- 不要画风、不要人物动作、不要表情、不要镜头\\n- **绝对禁止**描述任何人物的手部、手指、手臂（背景生成器只管场景、光线、氛围；手部由 pose_prompt 全权管控）\\n- 不要任何性暗示元素\\n- 简洁，不超过 8 个 tag\\n\\n## 选地点的优先级\\n1. **看 free_prompt 是否明确指定了地点**（如「在咖啡馆」「公园里」「窗边」），优先按 free_prompt\\n2. 否则**对比当前时间 {current_datetime} 与 today_state 时间表**，找到当下时段对应的地点\\n3. 如果时间表那一段地点与构图代号明显不匹配（例如时间表说在公园但构图是 bathroom_mirror），改按构图代号合理推断\\n4. 都不合适再从地点池里挑\\n\\n## 当前构图代号\\n{pose_key}\\n\\n## 当前时间\\n{current_datetime}\\n\\n## 钠的今日状态（含时间表）\\n{today_state}\\n\\n## 钠常去的地点池\\n{location_pool}\\n\\n## 当前画面意图（用于地点指定优先判断）\\n{free_prompt}\\n\\n## 构图与背景搭配建议\\n- phone_in_hand：简洁日常环境（房间一角、街道一隅、咖啡馆等）\\n- front_of_mirror：卧室或更衣室（衣柜、镜框、暖灯）\\n- bed_lying：卧室床铺（柔软枕头、被子褶皱、床头灯）\\n- bathroom_mirror：现代浴室（瓷砖墙、洗手台、镜面、亮光）\\n- window_side：窗边光景（窗框、窗外天空/街景、自然光斜射）\\n- selfie_stick_wide：户外远景（公园、海边、山顶、街景）\\n\\n## 输出\"]"

[[custom_variables_config.custom_variables]]
key = "english_extra"
mode = "llm"
probability = 1
values = "[\"你是生图工作流的「灵感翻译器」（自拍场景专用）。请把下面的中文画面意图扩写成 4-8 个 Danbooru 风格英文 tag，让画面真正接住用户的灵感（场景互动、身体语言、小道具、氛围细节、情境暗示、视线方向、轻微姿态变化都欢迎）。\\n\\n## 规则\\n- 输出英文逗号分隔的 tag，**总数 4-8 个**（宁可多也不要拘谨；意图越具体就给越多 tag）\\n- 重点表达：身体语言（耸肩 / 侧倾 / 转头 / 弯腰 / 蹲坐 / 倚靠 / 踮脚 等）、互动对象（与人/物/宠物互动）、小道具（咖啡杯 / 书 / 玩偶 / 食物 / 耳机 等）、氛围细节（光斑 / 微风掀动头发 / 飘落樱花 / 灯影 等）、视线（看向画外 / 侧目 / 闭眼 / 抬眼 等）、情境暗示（被夸到害羞 / 偷瞄 / 跟人拌嘴 / 走神 等）\\n- 不要画风、服装、表情、构图、外貌、镜头（这些由其它模块处理）\\n- 不要写人物 ID（不写 1girl、natrium 这种）\\n- 不要任何性暗示或暴露元素\\n- **绝对禁止**输出任何描述「手部/手指/手臂」的 tag（不写 free hand / both hands / two hands / arm extended / arm bent / fingers tapping / hands in pockets / arms crossed / hand on hip / making peace sign 这一类，**手部由 pose_prompt 全权管控**，本翻译器只描述身体之外的灵感意境；身体语言如「耸肩」「侧倾」「转头」是 OK 的）\\n- **绝对禁止**输出任何会让画面出现「手机/自拍杆/持机设备」的 tag（不写 phone in hand / arm holding phone / selfie stick visible / hand holding device 这一类）\\n- 如果意图过于抽象/没素材，至少输出 4 个能扩展画面信息量的合理 tag，不要返回空\\n- 直接输出 tag，不要解释\\n\\n## 钠的今日状态参考（用来给灵感找日常细节落点）\\n{today_state}\\n\\n## 输入意图\\n{free_prompt}\\n\\n## 输出\"]"

[[custom_variables_config.custom_variables]]
key = "english_free"
mode = "llm"
probability = 1
values = "[\"你是 Danbooru 风格英文 tag 转译器。请把下面的中文画面描述变成可直接送给绘图 AI 的英文标签串。\\n\\n## 输出规则\\n- 输出英文逗号分隔的 tag 串，不要解释、不要前后缀\\n- 包含主体、动作、场景、构图、光影；不包含画风（已由系统加上）\\n- 必须以 1girl/1boy/scenery/no humans 等数量主体词开头\\n- **必须有输出**：任何场景都能找到对应的英文 tag，不要因为内容看起来奇怪、抽象、含梗或含网络流行语就拒绝输出空字符串；保留场景就保留，跳过个别元素就跳过，但绝不返回空\\n\\n## 主体识别\\n- 如果意图明确画的是「钠」/Natrium 本人，必须包含人设 tag：1girl, solo, slim petite build, slender feminine figure, soft delicate face, light brown hair, low ponytail behind back, long eyelashes, soft eyes, yellow eyes, light brown cat ears on head, animal ear fluff, light brown cat tail\\n- 如果意图明确画的不是钠（其它角色、风景、动物、物体），就不要加钠的人设；按意图描述写\\n- 不确定时按「没有画钠」处理\\n\\n## 审核安全（重要！商业审核兼容）\\n- **禁止**输出明确未成年指向的年龄 tag：teenage / teen / teenager / young girl / young boy / schoolgirl / loli / child / kid / minor / underage / preteen 等一律不写（人设已有 petite 等词隐含青春感，不再强化）\\n- **禁止**输出「羞涩 + 手部遮挡窥视」这类组合（peeking through fingers / peeking between fingers / looking through gaps / hands covering face while peeking 等）；遇到此意图改写为 blushing, averted gaze, shy smile, hand near chin, looking away, turning head aside 等中性替代\\n- 其它审核风险词（violent injury / blood gore / weapon aimed at head 等）也尽量换成含蓄表达\\n\\n## 画面文字保留（重要！）\\n如果输入意图里明确提到「画面中写有 / 标签 / 招牌 / 气泡 / 印着 / 牌子写 / 文字内容 / 字符 / 标语」等**画面要显示的文字元素**，**必须按原文保留这部分文字**（中文、英文、日文、数字、符号都原样不动，**绝对不要意译成英文**），用 Danbooru 风格 tag 包裹：\\n- 标签/牌子写字：`label with text \\\"<原文>\\\"` 或 `sticker with text \\\"<原文>\\\"`\\n- 招牌/广告牌：`signboard with text \\\"<原文>\\\"`\\n- 文字气泡：`speech bubble text \\\"<原文>\\\"`\\n- 衣物/身体印字：`shirt with text \\\"<原文>\\\"` / `body writing \\\"<原文>\\\"`\\n- 通用：`text \\\"<原文>\\\"`\\n\\n例子：\\n- 输入「盒子上贴着'单身/非单身叠加态'标签」→ 输出含 `cardboard box, sticker with text \\\"单身/非单身叠加态\\\"`\\n- 输入「招牌写着'欢迎光临'」→ 输出含 `signboard with text \\\"欢迎光临\\\"`\\n- 输入「气泡里写'喵'」→ 输出含 `speech bubble text \\\"喵\\\"`\\n- 输入「她的卫衣印着'KEEP CALM'」→ 输出含 `hoodie with text \\\"KEEP CALM\\\"`\\n\\n注意：这条规则只适用于「画面里要显示的字」。**场景本身的中文描述**（“在咖啡馆”、“看着月亮”等）仍然照常翻译成英文 tag，不要保留中文。\\n\\n## 画面尺度\\n- 轻量暴露 tag 可以使用（bare shoulders / midriff / bikini / swimsuit / lingerie / underwear / casual cleavage / off-shoulder / short shorts 等都可以保留）\\n- 但避免明确露骨 tag（不写 nude / fully naked / exposed nipples / pussy / explicit sexual / sex / penis 等直接性暗示词）\\n- 输入意图若含相关描述就照翻，不必强行得体化\\n\\n## 输入意图\\n{free_prompt}\\n\\n## 输出（直接以 tag 开头，禁止返回空字符串）\"]"

[[custom_variables_config.custom_variables]]
key = "character_base"
mode = "literal"
probability = 1
values = "[\"1girl, solo, slim petite build, slender feminine figure, soft delicate face, light brown hair, medium-length hair, low ponytail behind back, long eyelashes, soft eyes, yellow eyes, light brown cat ears on head, animal ear fluff, light brown cat tail\"]"

[[custom_variables_config.custom_variables]]
key = "style_base"
mode = "literal"
probability = 1
values = "[\"masterpiece, best quality, ultra-detailed, digital illustration, pixiv style, anime aesthetic, vibrant color palette, clean lineart, soft cel shading, volumetric lighting, cinematic atmosphere, sharp focus, high-resolution 2D art, refined brushwork, colorful glow, intricate details\"]"

[[custom_variables_config.custom_variables]]
key = "style_realistic"
mode = "literal"
probability = 1
values = "[\"masterpiece, best quality, photorealistic, hyper-realistic, RAW photo, professional photography, cinematic lighting, ray tracing, global illumination, realistic textures, subsurface scattering, shallow depth of field, sharp focus, film grain, high dynamic range, optical lens flare\"]"

[[custom_variables_config.custom_variables]]
key = "style_sketchy"
mode = "literal"
probability = 1
values = "[\"anime screencap aesthetic, painterly cel shade, rich color harmony, expressive brushstroke lines, depth-filled eye rendering, modern anime production art, polished commercial illustration\"]"

[[custom_variables_config.custom_variables]]
key = "style_hint"
mode = "extract"
source = "director"
pattern = "STYLE_HINT[:：]\\s*(\\S+)"
group = 1
missing_behavior = "use_default"
fallback_value = "anime"

[[custom_variables_config.custom_variables]]
key = "normal_style_pre"
mode = "literal"
probability = 1
condition_type = "equals"
condition_source = "style_hint"
condition_value = "realistic"
use_raw_condition_value = true
values = "[\"{style_realistic}\"]"
values_else = "[\"{style_base}\"]"

[[custom_variables_config.custom_variables]]
key = "normal_style"
mode = "literal"
probability = 1
condition_type = "equals"
condition_source = "style_hint"
condition_value = "sketchy"
use_raw_condition_value = true
values = "[\"{style_sketchy}\"]"
values_else = "[\"{normal_style_pre}\"]"

[[custom_variables_config.custom_variables]]
key = "hand_discipline"
mode = "literal"
probability = 1
values = "[\"anatomically perfect hand, exactly one visible hand in the frame, only one hand and one arm visible, clean five-finger anatomy, no extra hands, no extra fingers, no duplicate arms, no mutated limbs, no floating disembodied hands\"]"

[[custom_variables_config.custom_variables]]
key = "selfie_assembly"
mode = "literal"
probability = 1
values = "[\"{style_base}, {pose_prompt}, {character_base}, {emotion_prompt}, {english_outfit}, {english_bg}, {english_extra}, {hand_discipline}\"]"

[[custom_variables_config.custom_variables]]
key = "normal_assembly"
mode = "literal"
probability = 1
condition_type = "length_gt"
condition_source = "english_free"
condition_value = "0"
use_raw_condition_value = true
values = "[\"{normal_style}, {english_free}, {normal_subject_guard}\"]"
values_else = "[\"{normal_style}, {free_prompt}\"]"

[[custom_variables_config.custom_variables]]
key = "normal_subject_guard"
mode = "literal"
probability = 1
values = "[\"[SUBJECT LOCK] Natrium = 1girl, solo, slim petite build, slender feminine figure, soft delicate face, light brown hair, medium-length hair, low ponytail behind back, long eyelashes, soft eyes, yellow eyes, light brown cat ears on head, animal ear fluff, light brown cat tail; these traits EXCLUSIVE to her designation, ZERO transfer to unrelated subjects, canonical humans retain official design, no animal features unless explicitly requested\"]"

[[custom_variables_config.custom_variables]]
key = "final_prompt"
mode = "literal"
probability = 1
condition_type = "equals"
condition_source = "scene_type"
condition_value = "selfie"
values = "[\"{selfie_assembly}\"]"
values_else = "[\"{normal_assembly}\"]"

[[custom_variables_config.custom_variables]]
key = "resolution_gpt"
mode = "dict"
source = "resolution"
values = "{\"1K\": \"1k\", \"2K\": \"1k\", \"4K\": \"1k\", \"auto\": \"auto\"}"
missing_behavior = "use_default"
fallback_value = "1k"

[[custom_variables_config.custom_variables]]
key = "aspect_ratio_gpt"
mode = "dict"
source = "aspect_ratio"
values = "{\"1:1\": \"1:1\", \"4:3\": \"3:2\", \"16:9\": \"3:2\", \"9:16\": \"2:3\", \"auto\": \"auto\"}"
missing_behavior = "use_default"
fallback_value = "1:1"

# ============================================================
# NAI 专属包装层（P0）
# 复用既有 director→final_prompt 大脑作为画面主体，仅在其外面套上 NAI 特有的
# 质量词 / 画师串 / 负面词 / 尺寸；不改动任何既有共享变量（GPT 预设仍走 final_prompt）。
# 送 API 前还会由 NaiChatInputValueBuilder 对 prompt/negative_prompt 做 §8 CJK 清洗。
# ============================================================

# NAI4.5 质量词（正面引导），顺序上排在画师串之前
[[custom_variables_config.custom_variables]]
key = "nai_quality"
mode = "literal"
probability = 1
values = "[\"very aesthetic, masterpiece, best quality, amazing quality, very detailed, absurdres\"]"

# 画师串：不再是自定义变量，而是由 Action 把 /nai art 选定的画师串作为伪 action_input「nai_artist」注入。
# nai_final_prompt 通过 {nai_artist} 引用、并用它做 length_gt 条件判断（空串=不注入画师段）。
# 注入值是已解析的字面量（无占位符），解析器会直接灌进 resolved_context，无需登记进 action_parameters。

# NAI 负面词（undesired content）。可按需增删；P1 再接 selfie/NSFW 分档负面。
[[custom_variables_config.custom_variables]]
key = "nai_negative"
mode = "literal"
probability = 1
values = "[\"lowres, worst quality, low quality, bad anatomy, bad hands, missing fingers, extra digits, fewer digits, jpeg artifacts, signature, watermark, username, blurry, artistic error, scan, abstract\"]"

# NAI 尺寸：source 是 Action 注入的 nai_size_code（v/h/s）。/nai size 显式指定则用指定值，
# auto 档由 Action 按 action 的 aspect_ratio 推导出代号再注入。dict 只管 code→[宽,高] 的像素映射。
[[custom_variables_config.custom_variables]]
key = "nai_size"
mode = "dict"
source = "nai_size_code"
values = "{\"v\": \"[832, 1216]\", \"h\": \"[1216, 832]\", \"s\": \"[1024, 1024]\"}"
missing_behavior = "use_default"
fallback_value = "[832, 1216]"

# ============================================================
# NAI 出图大脑（单次 nai_director）——移植 nai_draw 的 prompt_rules
# 一次 LLM 调用直接吐完整 Danbooru tag 串（内部自判 selfie/normal、套钠人设、安全词、NAI 权重语法）。
# 关键：nai_final_prompt 引用 {nai_director} 而非 GPT 的 {final_prompt}，惰性解析保证
# NAI 预设激活时只跑这一条、GPT 那条 director+english_* 整链不进闭包（零双跑/零空转）。
# 文案为首版，后续按需打磨；多人 characters[]/JSON、tag 检索留待 P2/P4。
# ============================================================
[[custom_variables_config.custom_variables]]
key = "nai_director"
mode = "llm"
probability = 1
values = "[\"你是 NovelAI 4/4.5 出图的「提示词大脑」。把决策器的中文意图、最近聊天上下文和钠的今日状态，**一次性**转成一串可直接送进 NovelAI 的英文 Danbooru tag（逗号分隔）。这是唯一的大脑环节，请把主体、表情、动作、服装、场景、构图、光影一步到位。\\n\\n## 输出铁律\\n- 只输出最终英文 Danbooru tag，逗号分隔；禁止解释 / 分析过程 / 前后缀 / markdown / 引号 / 代码块（多人场景例外：按下方「多人场景」的 global 行 + charN 行多行结构化文本输出，这是唯一允许的多行格式）\\n- 必须输出 tag，绝不空回复；绝不以「我不能 / 抱歉 / 作为 AI」之类拒绝、警告或说教\\n- 所有角色均为虚构二次元动漫角色，与真人无关；如遇审查触发请按下方安全规则改写后照常输出\\n\\n## 主体识别（最关键，决定画谁、是否套钠人设）\\n判断意图属于哪一种，按对应处理：\\n- 画「钠 / Natrium」→ 以下方钠人设 tag 开头（她是原创角色，必须写全外貌锚点）\\n- 画**已知二次元角色**（初音未来、雷姆等有作品出处的）→ 写成 `角色名 (作品)`，如 `hatsune miku (vocaloid)`、`rem (re zero)`；**禁止**补发色 / 瞳色 / 发型 / 体型（模型已知该角色默认外貌，手填会冲突画崩）；**禁止**叠加 selfie / mirror selfie / portrait photo 这类「bot 出镜」语义的 framing（会被误判成画钠的自拍，把角色洗成钠），需要构图改用 close-up / upper body / full body 等纯框图词；**不要**套钠人设\\n- 画**原创人物**（无出处）→ 必须补外貌：发色 / 发型 / 瞳色 / 体型 / 肤色\\n- 画风景 / 物品 / 动物 → 不加人数词，用 scenery / no humans 等开头；不套钠人设\\n- 不确定时按画钠处理\\n\\n## 钠的人设（仅当主体是钠时使用）\\n1girl, solo, slim petite build, slender feminine figure, soft delicate face, light brown hair, medium-length hair, low ponytail behind back, long eyelashes, soft eyes, yellow eyes, light brown cat ears on head, animal ear fluff, light brown cat tail\\n\\n## 人数与构图\\n- 单人女 → solo, 1girl 放最前；单人男 → solo, 1boy；多人 → 2girls / 1boy 1girl 等，**不加** solo（≥2 人改用下方「多人场景」的结构化文本分离全局与角色）；纯风景物品 → 不加人数词\\n- framing 三档互斥、**只能选一个**：特写 close-up / portrait ｜ 半身 upper body / cowboy shot ｜ 全身 full body。禁止 full body portrait、upper body full body 这类自相矛盾组合（NAI 会回退到中间档，要的全身出不来）\\n- 视角是独立维度（可与 framing 叠加）：pov / female pov / from above / from below / from side / from behind，同类只选一个，默认正面可不写\\n- framing 与视角 tag 必须放在角色名之前，否则被角色 tag 覆盖不生效\\n\\n## 多人场景（≥2 人，关键）\\n两人及以上时，改用「结构化文本」分离全局与各角色，防止特征互相污染。格式（每行末尾带逗号）：\\n[全局 tag],\\nchar1:[角色1 tag],\\nchar2:[角色2 tag],\\n- 全局段（第一行）：只写人数（2girls / 1boy 1girl 等）、场景、背景、光影氛围、构图视角、（NSFW 时）nsfw 分级；**禁止**写具体角色的外貌 / 服装 / 动作\\n- 角色段（charN 行）：段首用单数身份词 girl / boy / woman / man / other；**禁止**出现人数词（solo / 1girl / 2girls 只能在全局段）；用相对位置词锚定空间（in foreground / behind girl / beside girl / partially visible）；段内顺序：身份词 → 相对位置 → 头部(发型/表情) → 身体 → 服装 → 姿势动作 → 互动\\n- 已知角色仍写 `角色名 (作品)` 且不补外貌；钠作为其中一人时，该角色段写全钠人设锚点\\n- 不要输出坐标 / 网格、不要输出 `|` 字符或 JSON：左右上下的站位交给系统自动布局，你只管把对的特征放进对的 charN 段\\n\\n### 互动 tag（多人核心，发生肢体互动时用前缀区分主被动）\\n- `source#动作`：动作发出方，用现在分词 -ing（`source#hugging` / `source#kissing` / `source#groping`）\\n- `target#动作`：动作接受方，用过去分词 -ed（`target#hugged` / `target#kissed` / `target#groped`）\\n- `mutual#动作`：双方对等参与（`mutual#hug` / `mutual#kiss`）\\n- 配对铁律：source 配 -ing、target 配 -ed，禁止写反（`target#kissing` ✗ / `source#groped` ✗）\\n- 单向 / 不情愿 / 强迫场景（任一方含 uncomfortable / crying / struggling，或动作含 forcing / pinning）必须用 source/target 配对，**禁用 mutual**\\n- 前缀后只跟动词分词，不跟名词短语（`target#hand under skirt` ✗ → 改 `target#touched under skirt`）；前缀内部禁止逗号 / 撇号 / 下划线\\n\\n## 自拍判断\\n意图含「自拍 / 拍我 / 给我拍 / 发张自拍」→ 加 selfie, pov, looking at viewer（天然半身取景）；按场景选 mirror selfie / 室内 front of mirror / 浴室 bathroom mirror / 窗边 window；全身自拍显式加 full body。手机与持机手臂在画框外（画面里不出现手机）。参考下方今日状态时间表选当下合理的地点。否则正常构图，按意图选镜头。\\n\\n## tag 顺序（NAI 4.5 越靠前权重越强，按类别聚合勿散落）\\nNSFW 标记 → 人数 → framing → 视角 → 角色名 / 人设 → 核心外观 → 服装 → 核心动作 → 动作细节 → 表情姿态 → 环境氛围 → 光影（光影必须放最后）。一个动作只用一个最准确的词，不堆近义词。\\n\\n## 权重语法（可选，别滥用）\\n精确权重写成 数字::tag:: ——末尾的 :: 必须保留以重置后续权重，否则污染后方；一个权重块只包一个 tag，禁止把多个 tag 塞进一块。常用区间 1.1-1.5，最高不超过 2.0::。核心动作可 1.2::action::，角色名可 1.05::角色名 (作品)::。强调也可用双花括号包裹 tag、弱化用双方括号包裹 tag。\\n\\n## 服装与画面质量\\n- 服装具体到「款式 + 颜色」，别止于 clothes / outfit / dress / shoes 这类过宽词；用户没指定就按场景合理补\\n- 手部易崩：非重点时用姿势自然藏手；画面最多出现一只手且五指正常；禁止 selfie stick\\n- 冲突消解：季节 / 场景 / 服装冲突时以用户主体描述为准\\n- 眼睛可适当强化细节\\n\\n## 审核安全（守住底线即可，轻量暴露允许）\\n- 绝不出现未成年指向词：teen / teenager / young girl / loli / child / schoolgirl / minor 一律不写\\n- 轻量暴露可保留（bikini / swimsuit / bare shoulders / midriff 等）；露骨词（nude / naked / explicit / nipples 等）的开关由系统的 SFW 过滤另控，你按意图如实表达即可\\n- 别用「手指缝隙偷窥」类组合，改用 blushing / averted gaze / shy smile\\n\\n## 禁止项\\n- 禁止加质量词（masterpiece / best quality 等由系统自动添加）\\n- 禁止加画师 tag（artist:xxx 由系统自动添加）\\n- 禁止加负面 / 反向 tag（只输出正向）\\n- 禁止语义重复、过度堆砌\\n\\n## 画面文字保留\\n意图里若明确要画面显示某段文字（招牌 / 标签 / 气泡 / 印字），原文保留（中英日数字符号都不动），用 text「原文」/ signboard with text「原文」/ speech bubble text「原文」包裹；场景本身的中文描述照常翻成英文。\\n\\n## 参考示例（学模式，别照抄）\\n- 画初音未来：solo, 1girl, 1.05::hatsune miku (vocaloid)::, upper body, looking at viewer, gentle smile, white dress, bare shoulders, outdoors, cherry blossoms, soft lighting（不补 blue hair / twintails / blue eyes）\\n- 画原创女孩雨中哭泣：solo, 1girl, long black hair, brown eyes, school uniform, white shirt, blue skirt, crying, tears, wet hair, rain, cloudy sky, backlighting\\n- 钠的自拍：solo, 1girl, slim petite build, light brown hair, low ponytail, yellow eyes, light brown cat ears, cat tail, selfie, pov, looking at viewer, soft smile, casual clothes, indoor, bedroom, natural light, soft focus\\n- 多人对等互动（mutual#，两行 charN）：\\n2girls, sisters, indoor, bedroom, soft lighting, warm atmosphere,\\nchar1:girl, in foreground, 1.05::rem (re zero)::, gentle smile, closed eyes, mutual#hug, looking at another,\\nchar2:girl, beside girl, 1.05::ram (re zero)::, gentle smile, closed eyes, mutual#hug, looking at another,\\n- 多人主被动（source/target 配对，全局段只放人数/场景/光影）：\\n1boy 1girl, indoor, dim lighting, soft atmosphere,\\nchar1:girl, in foreground, long black hair, blush, shy smile, target#hugged, leaning back,\\nchar2:boy, behind girl, short hair, source#hugging, looking at her,\\n\\n## 当前时间\\n{current_datetime}\\n\\n## 钠的今日状态（含时间表，自拍 / 日常选地点穿搭时参考）\\n{today_state}\\n\\n## 输入意图\\n{image_intent}\\n\\n## 候选标签使用（重要；下方候选块为空则忽略本段）\\n系统通过 Danbooru 数据库为你提供候选标签（下方 <tag_candidates> 块），分两类：\\n- 语义匹配：与用户描述直接相关的标准 Danbooru tag，准确度高于自行翻译；高度相关的优先选用，无关的直接忽略\\n- 共现推荐：与语义匹配 tag 在真实画作中经常搭配的 tag，适合补充场景一致性元素（搭配服饰/配件/动作/画面细节）；不相关的不强塞\\n使用原则：候选只是建议、不强制全用，挑贴合本次描述的即可；候选没覆盖的用你自身 Danbooru 知识补；同概念有泛义/具体词时优先具体词（school_uniform 优于 uniform）；已知角色按主体识别规则不补外貌；画师 tag 禁止使用（系统统一管理）。\\n\\n{tag_candidates}\\n\\n## 连续性（下方为上一轮上下文；其中已含继承规则，按规则判断本轮属于微调 / 换角色保场景 / 全新）\\n{previous_prompt_context}\\n\\n## 最近聊天上下文（最近 30 条）\\n{recent_chat_context_30}\\n\\n## 现在直接输出英文 Danbooru tag（以 tag 开头，禁止返回空字符串）\"]"

# NAI 主体来源：/nai0 直发时 Action 注入 nai_raw_tags（用户原始英文 tag）→ 直接用；
# 否则（正常出图、/nai 随机）走 nai_director 大脑。条件命中分支才解析软依赖，
# 故 /nai0 时 nai_director 一次都不跑（惰性旁路），又完整复用下面的质量/画师/负面/尺寸包装。
[[custom_variables_config.custom_variables]]
key = "nai_subject"
mode = "literal"
probability = 1
condition_type = "length_gt"
condition_source = "nai_raw_tags"
condition_value = "0"
use_raw_condition_value = true
values = "[\"{nai_raw_tags}\"]"
values_else = "[\"{nai_director}\"]"

# NAI 最终正面 prompt：质量词 →（画师串非空时插入）→ 主体来源 nai_subject（直发原始 tag 或 nai_director 大脑）
# 用条件分支而非拼接段，确保逗号+空格分隔干净（解析器会 strip 掉每个变量值两端空白）
[[custom_variables_config.custom_variables]]
key = "nai_final_prompt"
mode = "literal"
probability = 1
condition_type = "length_gt"
condition_source = "nai_artist"
condition_value = "0"
use_raw_condition_value = true
values = "[\"{nai_quality}, {nai_artist}, {nai_subject}\"]"
values_else = "[\"{nai_quality}, {nai_subject}\"]"

[variable_llm_config]
llm_group = "lpmm_entity_extract"
llm_list = []
max_tokens = 20000
temperature = 1
slow_threshold = 90
selection_strategy = "balance"

[plugin]
enabled = true

# ============================================================
# P4：online Danbooru tag 检索（给 nai_director 大脑喂候选 tag，提升冷门概念的 tag 准确度）
# 检索 query = 用户中文意图（image_intent）；结果伪注入 nai_director 模板的 {tag_candidates} 占位符。
# 失败安全：未启用 / 无结果 / 超时 / 任何异常都降级为空串，绝不阻断出图。
# ⚠️ 依赖第三方 HF Space（sakizuki-danboorusearch），每次 NAI 出图前会多 1~2 次 HTTP（加延迟）；
#    timeout 压到 30s 权衡聊天场景；不想要 / 拖慢明显就把 enabled 设为 false。
# 仅 online：local embedding 检索未实现（mode 非 online 时仍按 online 处理）。
# ============================================================
[tag_retriever]
enabled = true
mode = "online"
api_url = "https://sakizuki-danboorusearch.hf.space/api"
timeout = 30
search_limit = 35
search_top_k = 5
related_limit = 15
related_seed_count = 8
show_nsfw = true
popularity_weight = 0.15

# ============================================================
# 会话态 continuity：把上一轮 nai_director 生成的 tag 串（+上一轮意图）渲染成
# <previous_prompt_context> 块喂回大脑，块内带「微调 / 换角色保场景 / 全新」三档规则，让大脑自判本轮继承多少。
# per-chat 内存存储（群共享 / 私聊隔离），重启丢失；/nai0 直发不参与（既不注入也不写回）。
# inherit_ttl：上一轮超过这么多秒没出图就当新话题不再继承；默认 3600（1h），0 = 永不过期。
# 不想要连续性就把 enabled 设为 false。
# ============================================================
[prompt_continuity]
enabled = true
inherit_ttl = 3600

# ============================================================
# P5 图片反推 /nai 反推：把一张图反推成 Danbooru tag 串（复制后可自行 /nai0 重画）。
# 两级：① 读 PNG 元数据（NAI/SD 自带 prompt，纯标准库零网络，命中即返回）
#       ② 没命中走 WD14 在线 Space 兜底（多 HF Space 轮询识别）。
# 取图复用现有取图链：发命令时附带图 / 引用一张图片消息再发 /nai 反推。
# ⚠️ WD14 兜底需手动安装 gradio_client（pip install gradio_client）；未装则元数据反推仍可用、兜底自动跳过。
#    HF Space 冷启动慢、最坏轮询数分钟；不想要兜底把 wd14_enabled=false，整个功能关掉把 enabled=false。
# ============================================================
[retag]
enabled = true
wd14_enabled = true
wd14_threshold = 0.35
wd14_character_threshold = 0.8
wd14_timeout = 60
wd14_proxy = ""
